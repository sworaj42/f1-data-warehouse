# Copy to .env and adjust. .env is gitignored and must never be committed.
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
PROD_DB=f1_prod
DW_DB=f1_dw

# Jolpica-F1 API (Ergast successor)
API_BASE_URL=https://api.jolpi.ca/ergast/f1

# Backfill season range (inclusive)
SEASON_START=1994
SEASON_END=2026

# --- Airflow (docker-compose.airflow.yml) ------------------------------------
# Containers write files as your host user instead of root.
AIRFLOW_UID=501

# Encrypts connection passwords in the Airflow metadata DB. Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=hwDHn64rLheDk3Jx7v-Kmme2f5xFgtBUoiv2uFhL2E4=

# Airflow Connections, registered from the environment. AIRFLOW_CONN_<NAME>
# becomes conn_id <name> lowercased, so these are "f1_oltp" and "f1_dw".
#
# host.docker.internal, NOT localhost: f1_postgres runs in a DIFFERENT compose
# stack, so from inside an Airflow container "localhost" is the container itself.
# This is also why the DAGs never read POSTGRES_HOST -- connections come from
# Airflow, and every etl/ function takes an open conn as its first argument.
AIRFLOW_CONN_F1_OLTP=postgres://f1:f1@host.docker.internal:5433/f1_prod
AIRFLOW_CONN_F1_DW=postgres://f1:f1@host.docker.internal:5433/f1_dw
